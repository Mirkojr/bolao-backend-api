# .env.example
# Copie para .env (cp .env.example .env). Os valores abaixo servem para
# desenvolvimento local; em produção, troque todas as senhas e o segredo.

# Configurações do Servidor
PORT=3000
CORS_ORIGINS=http://localhost:5173,https://bolao-frontend-five.vercel.app
MAX_API_CALLS=1000
# tentativas de login com erro, por IP, a cada 15 min
MAX_LOGIN_ATTEMPTS=10

# Configurações do Banco de Dados PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASS=admin123S
DB_NAME=bolao_db

# admin configs
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@email.com
ADMIN_PASS=admin123

# Config Auth JWT (gere um valor seu com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
ACCESS_TOKEN_KEY=troque_este_segredo_em_producao
