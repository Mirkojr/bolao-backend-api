{
  "name": "bolao-backend-api",
  "version": "1.0.0",
  "description": "Backend do sistema",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "start": "npm run db:migrate && node src/server.js",
    "dev": "npm run db:migrate && nodemon -L src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "seed": "node src/seeders/seed.js",
    "seed:reset": "node src/seeders/seed.js --reset",
    "seed:xl": "node src/seeders/seed.js --reset --xl",
    "seed:mega": "node src/seeders/seed.js --reset --mega"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfmake": "^0.3.11",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
